{
  "name": "vtes-italy-draft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VTES Draft Cube interactive gallery (static site, vanilla JS, Python build pipeline).",
  "license": "MIT",
  "author": "VTES Italy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilofruttaldo/VtesItaly.Draft.git"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 node scripts/run-tests.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "minify": "node scripts/minify.mjs"
  },
  "c8": {
    "include": [
      "assets/**/*.{js,mjs}",
      "scripts/**/*.mjs"
    ],
    "exclude": [
      "**/*.test.mjs",
      "scripts/run-tests.mjs"
    ],
    "reporter": [
      "text-summary",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 65,
    "statements": 65,
    "functions": 70,
    "branches": 60
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.11.4",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
